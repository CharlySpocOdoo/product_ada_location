<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_ada_location" model="ir.ui.view">
        <field name="name">product.product.form.ada_location</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Ubicaciones ADA" name="ada_location_tab">
                    <field name="ada_location_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="location"/>
                            <field name="quantity" sum="Cantidad total"/>
                            <field name="date"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
